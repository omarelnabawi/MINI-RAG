APP_NAME="mini-rag"
APP_VERSION="0.1"
OPENAI_API_KEY="your_openai_api_key_here"

FILE_ALLOWED_TYPES=[
    "text/plain",
    "application/pdf"]
FILE_MAX_SIZE=10 # 10MB
FILE_DEFAULT_CHUNK_SIZE=512000 # .5 MB

MONGODB_URL="mongodb://localhost:27007"
MONGODB_DATABASE="mini-rag"

GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY="api_key"
OPENAI_API_URL="api_url"
CHOHERE_API_KEY="api_key"

GENERATION_MODEL_ID="openai/gpt-oss-120b"
EMBEDDING_MODEL_ID="embed-multilingual-v3.0"
EMBEDDING_MODEL_SIZE=1024

INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPRATURE=.1

#========================Vector Database Config=====================
VECTORDATABASE_BACKEND="QDRANT"
VECTORDATABASE_QDRANT_DB_PATH="assets/qdrant"
VECTORDATABASE_DISTANCE_METHOD="cosine"